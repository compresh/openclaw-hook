{
  "name": "@compresh/openclaw-hook",
  "version": "0.3.6",
  "description": "OpenClaw Plugin SDK hook for per-turn context compression via Compresh — episodic memory architecture for LLMs",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "compresh",
    "context-compression",
    "llm",
    "agent-middleware",
    "tulving",
    "episodic-memory",
    "plugin-sdk"
  ],
  "license": "MIT",
  "author": {
    "name": "Compresh Ltd",
    "email": "hello@compre.sh",
    "url": "https://compre.sh"
  },
  "homepage": "https://compre.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/compresh/openclaw-hook.git"
  },
  "bugs": {
    "url": "https://github.com/compresh/openclaw-hook/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "runtimeExtensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.0",
      "minGatewayVersion": "2026.5.0"
    },
    "build": {
      "openclawVersion": "2026.5.18",
      "pluginSdkVersion": "2026.5.18"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp openclaw.plugin.json dist/openclaw.plugin.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": false
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openclaw": "^2026.5.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
